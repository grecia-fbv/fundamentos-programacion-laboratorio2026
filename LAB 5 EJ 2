#include <stdio.h>

int main() {
    float practica1, practica2, practica3, examenTeorico, proyectoFinal;
    float promedioPonderado;
    
    // Leer las 5 notas
    printf("Ingrese la nota de la práctica 1: ");
    scanf("%f", &practica1);
    printf("Ingrese la nota de la práctica 2: ");
    scanf("%f", &practica2);
    printf("Ingrese la nota de la práctica 3: ");
    scanf("%f", &practica3);
    printf("Ingrese la nota del examen teórico: ");
    scanf("%f", &examenTeorico);
    printf("Ingrese la nota del proyecto final: ");
    scanf("%f", &proyectoFinal);
    
    // Calcular promedio ponderado
    promedioPonderado = (practica1 * 0.15) + (practica2 * 0.15) + (practica3 * 0.15) +
                        (examenTeorico * 0.35) + (proyectoFinal * 0.20);
    
    // Mostrar resultado
    printf("\n--- Resultado ---\n");
    printf("Nota final ponderada: %.2f\n", promedioPonderado);
    
    return 0;
}
